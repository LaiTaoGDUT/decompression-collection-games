[Unit]
Description=Decompression local read-only game data viewer
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=decompression-viewer
Group=decompression-viewer
SupplementaryGroups=decompression-api
WorkingDirectory=/opt/decompression-api/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/decompression-api/app/viewer/index.cjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET
MemoryMax=128M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
