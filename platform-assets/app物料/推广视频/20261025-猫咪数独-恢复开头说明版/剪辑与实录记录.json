    {
      "start": 36.107692,
      "end": 38.415385,
      "sourceStart": 53.0,
      "sourceEnd": 56.0,
      "text": "蓝绿色锁住一列，继续缩小范围"
    },
    {
      "start": 38.415385,
      "end": 40.876923,
      "sourceStart": 56.0,
      "sourceEnd": 59.2,
      "text": "第四行只剩左边，双击放猫"
    },
    {
      "start": 40.876923,
      "end": 45.030769,
      "sourceStart": 59.2,
      "sourceEnd": 64.6,
      "text": "相邻格划掉，找到蓝色的位置"
