      "sourceEnd": 18.7,
      "text": "橙色区域只有一格，所以先双击放猫"
    },
    {
      "start": 6.7,
      "end": 8.7,
      "sourceStart": 18.7,
      "sourceEnd": 20.7,
      "text": "同一行的其他格子，都划掉"
    },
    {
      "start": 8.7,
      "end": 10.7,
      "sourceStart": 20.7,
      "sourceEnd": 22.7,
      "text": "同一列的其他格子，也划掉"
    },
    {
      "start": 10.7,
      "end": 13.2,
      "sourceStart": 22.7,
      "sourceEnd": 25.2,
      "text": "猫咪不能相邻，周围八格划掉"
    },
    {
      "start": 13.2,
      "end": 15.2,
      "sourceStart": 25.2,
      "sourceEnd": 27.2,
      "text": "紫色只剩一格，双击找到下一只"
    },
    {
      "start": 15.2,
      "end": 19.8,
      "sourceStart": 27.2,
      "sourceEnd": 31.8,
      "text": "排除之后，再找唯一的位置"
    },
    {
      "start": 19.8,
      "end": 22.492308,
      "sourceStart": 31.8,
      "sourceEnd": 35.3,
      "text": "找到一只，就划掉同行同列"
    },
    {
      "start": 22.492308,
      "end": 26.338462,
      "sourceStart": 35.3,
      "sourceEnd": 40.3,
      "text": "黄色只能在第一行，划掉别的颜色"
    },
    {
      "start": 26.338462,
      "end": 29.953846,
      "sourceStart": 40.3,
      "sourceEnd": 45.0,
      "text": "蓝色候选都在这一列，继续排除"
    },
    {
      "start": 29.953846,
      "end": 33.030769,
      "sourceStart": 45.0,
      "sourceEnd": 49.0,
      "text": "这一行只剩一格，再找到一只"
